# Netlify CLI local state (site link, functions cache) - never commit
.netlify/

# Environment files - nothing env-specific may ever be committed.
# (*.local already covers .env.local; this covers .env, .env.production, etc.)
.env
.env.*
!.env.example

# Any zip artifact (prebuilt deploy drops, asset archives)
*.zip
